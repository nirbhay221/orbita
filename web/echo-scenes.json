{
  "_comment": "The lines on the Echo-style demo page. Each one is a real tool call with real arguments, kept here so a test can call every one of them. A line with an input takes what is typed and puts it in the named argument.",
  "groups": [
    {
      "name": "First, the farm",
      "lines": [
        {
          "say": "The Yuma Block, near Yuma, Arizona. The planter runs RTK.",
          "tool": "my_farm",
          "args": {
            "fieldName": "Yuma Block",
            "place": "Yuma, Arizona",
            "machineName": "planter",
            "correction": "rtk"
          }
        },
        {
          "say": "The sprayer is on WAAS.",
          "tool": "my_farm",
          "args": {
            "machineName": "sprayer",
            "correction": "sbas"
          }
        },
        {
          "say": "Add Dana to the crew, dana@example.com.",
          "tool": "crew_contact",
          "args": {
            "action": "add",
            "name": "Dana",
            "email": "dana@example.com",
            "role": "planter operator"
          }
        },
        {
          "say": "Yes, add her.",
          "tool": "crew_contact",
          "args": {
            "action": "confirm",
            "name": "Dana"
          }
        }
      ]
    },
    {
      "name": "Can the job run",
      "lines": [
        {
          "say": "No GPS. We're right in the middle of corn planting.",
          "tool": "can_i_run",
          "args": {
            "operation": "planting",
            "equipment": "planter"
          },
          "who": "Kevin Kenney, a Nebraska farmer, 10 May 2024",
          "source": "https://www.fox9.com/news/solar-storm-2024-gps-farming-problems"
        },
        {
          "say": "Can I spray?",
          "tool": "can_i_run",
          "args": {
            "operation": "spraying",
            "equipment": "sprayer"
          }
        },
        {
          "say": "What about a survey tomorrow afternoon?",
          "tool": "can_i_run",
          "args": {
            "operation": "surveying",
            "equipment": "planter",
            "when": "tomorrow afternoon"
          }
        },
        {
          "say": "How is the whole farm looking?",
          "tool": "farm_status",
          "args": {}
        },
        {
          "say": "There is currently a very high KP index has anyone had any Issues using GPS navigation?",
          "tool": "storm_status",
          "args": {},
          "who": "A drone builder on the ArduPilot forum, 11 May 2024",
          "source": "https://discuss.ardupilot.org/t/solar-gps-interference/117661"
        },
        {
          "say": "May 10, 2024: it showed the tractor going in circles and auto steer didn't work, and you couldn't engage it.",
          "tool": "what_happened",
          "args": {
            "when": "May 10 2024"
          },
          "who": "Dennis Wolff, a South Dakota farmer, on that day",
          "source": "https://www.fox9.com/news/solar-storm-2024-gps-farming-problems"
        },
        {
          "say": "Tell me more.",
          "tool": "tell_me_more",
          "args": {}
        }
      ]
    }
  ]
}
