{
  "_comment": "The demo page's requests live here so a test can call every one of them and prove each button is a real tool with real arguments. {{next-friday}} is filled in at load.",
  "groups": [
    {
      "name": "Everyone",
      "requests": [
        {
          "say": "What is the sun doing?",
          "tool": "storm_status",
          "args": {}
        },
        {
          "say": "I want to see the aurora tonight.",
          "tool": "what_should_i_do",
          "args": {
            "role": "aurora"
          }
        },
        {
          "say": "Did space weather ruin 10 May 2024?",
          "tool": "what_happened",
          "args": {
            "when": "10 May 2024",
            "operation": "planting"
          },
          "slow": true
        },
        {
          "say": "My guidance is out. What else is affected?",
          "tool": "what_else_is_affected",
          "secondary": true,
          "args": {}
        },
        {
          "say": "What can you do?",
          "tool": "what_can_you_do",
          "args": {}
        }
      ]
    },
    {
      "name": "Farms",
      "requests": [
        {
          "say": "Can I plant the North 40 right now?",
          "tool": "can_i_run",
          "args": {
            "operation": "planting",
            "field": "North 40"
          }
        },
        {
          "say": "Could I spray instead?",
          "tool": "can_i_run",
          "args": {
            "operation": "spraying",
            "field": "North 40",
            "equipment": "the sprayer"
          }
        },
        {
          "say": "I have to be planted by {{next-friday}}.",
          "tool": "can_i_run",
          "args": {
            "operation": "planting",
            "field": "North 40",
            "deadline": "{{next-friday}}"
          }
        },
        {
          "say": "I need twelve hours of planting and six of spraying. When do I run them?",
          "tool": "schedule_jobs",
          "args": {
            "jobs": [
              {
                "operation": "planting",
                "hours": 12,
                "equipment": "planter"
              },
              {
                "operation": "spraying",
                "hours": 6,
                "equipment": "sprayer"
              }
            ]
          }
        },
        {
          "say": "Which weeks in the next month and a half are worth booking a crew for?",
          "tool": "plan_season",
          "args": {}
        },
        {
          "say": "How many hours did space weather cost the planter this year?",
          "tool": "outage_patterns",
          "args": {
            "period": "year",
            "operation": "planting",
            "equipment": "planter"
          },
          "slow": true
        },
        {
          "say": "Tell me when planting clears.",
          "tool": "watch_jobs",
          "args": {
            "action": "start",
            "operation": "planting",
            "field": "North 40"
          }
        },
        {
          "say": "I planted 40 acres this morning.",
          "tool": "log_job",
          "args": {
            "operation": "planting",
            "field": "North 40",
            "acres": 40
          }
        },
        {
          "say": "When does it clear?",
          "tool": "can_i_run",
          "args": {
            "operation": "planting",
            "field": "North 40"
          }
        },
        {
          "say": "What can I run at all today?",
          "tool": "farm_status",
          "args": {}
        },
        {
          "say": "Is anything clear yet?",
          "tool": "watch_jobs",
          "args": {
            "action": "check"
          }
        },
        {
          "say": "Give me the report for the last week.",
          "tool": "job_report",
          "args": {
            "days": 7
          }
        }
      ]
    },
    {
      "name": "Drones and survey",
      "requests": [
        {
          "say": "I am flying a drone show in Hong Kong tonight. Can it run?",
          "tool": "can_i_run",
          "args": {
            "operation": "drone_show",
            "place": "Hong Kong",
            "when": "tonight"
          }
        },
        {
          "say": "Can my survey crew work near Ludhiana, India?",
          "tool": "can_i_run",
          "args": {
            "operation": "surveying",
            "place": "Ludhiana, India"
          }
        },
        {
          "say": "I run autonomous haul trucks at a mine.",
          "tool": "what_should_i_do",
          "args": {
            "role": "mining"
          }
        }
      ]
    },
    {
      "name": "Satellites and space",
      "requests": [
        {
          "say": "I run satellites. What should I do?",
          "tool": "what_should_i_do",
          "args": {
            "role": "satellite_operator"
          }
        },
        {
          "say": "I run geostationary satellites. Is charging a risk right now?",
          "tool": "what_should_i_do",
          "args": {
            "role": "satellite_operator",
            "orbit": "high"
          }
        },
        {
          "say": "We have a crew on the way to the Moon. What should we do about the sun?",
          "tool": "what_should_i_do",
          "args": {
            "role": "crewed_spaceflight",
            "orbit": "beyond"
          }
        }
      ]
    },
    {
      "name": "Flights, ships, radio",
      "requests": [
        {
          "say": "I dispatch flights.",
          "tool": "what_should_i_do",
          "args": {
            "role": "airline"
          }
        },
        {
          "say": "I hold a ship on position offshore.",
          "tool": "what_should_i_do",
          "args": {
            "role": "maritime_dp"
          }
        },
        {
          "say": "I run a shortwave radio net.",
          "tool": "what_should_i_do",
          "args": {
            "role": "hf_radio"
          }
        }
      ]
    },
    {
      "name": "Power, data, timing",
      "requests": [
        {
          "say": "I am on the grid control desk.",
          "tool": "what_should_i_do",
          "args": {
            "role": "grid_operator"
          }
        },
        {
          "say": "I run a GPU cluster. What should I do about this storm?",
          "tool": "what_should_i_do",
          "args": {
            "role": "data_centre"
          }
        },
        {
          "say": "Our cell network takes its time from GPS.",
          "tool": "what_should_i_do",
          "args": {
            "role": "timing"
          }
        }
      ]
    },
    {
      "name": "Robots",
      "requests": [
        {
          "say": "I'm a delivery robot in Fargo. Can I trust my GPS position right now?",
          "tool": "position_trust",
          "args": {
            "lat": 46.88,
            "lon": -96.79
          }
        }
      ]
    }
  ],
  "tools": [
    "can_i_run",
    "storm_status",
    "farm_status",
    "what_should_i_do",
    "what_else_is_affected",
    "what_happened",
    "what_can_you_do",
    "watch_jobs",
    "log_job",
    "job_report",
    "crew_contact",
    "register_field",
    "register_equipment",
    "remove",
    "plan_season",
    "share_access",
    "tell_me_more",
    "position_trust",
    "schedule_jobs",
    "outage_patterns"
  ],
  "seed": {
    "field": {
      "name": "North 40",
      "lat": 42.03,
      "lon": -93.62,
      "crop": "corn",
      "acres": 40,
      "baselineKm": 18
    },
    "equipment": [
      {
        "name": "the planter",
